POSTGRES_PASSWORD=replace-me
NEXUS_ADMIN_USERNAME=admin
NEXUS_ADMIN_PASSWORD=replace-me
# Set from the host: stat -c '%g' /var/run/docker.sock (required; no default)
DOCKER_GID=
# Optional; VPS CD sets these from GHCR.
# NEXUS_BACKEND_IMAGE=ghcr.io/iv4n89/nexus/backend:latest
# NEXUS_FRONTEND_IMAGE=ghcr.io/iv4n89/nexus/frontend:latest
# NEXUS_VERSION=dev
# Backend is host-networked; DATABASE_URL in compose is jdbc:postgresql://127.0.0.1:5432/nexus
