DATABASE_URL=jdbc:postgresql://localhost:5432/nexus
DATABASE_USERNAME=nexus
DATABASE_PASSWORD=nexus
NEXUS_ADMIN_USERNAME=admin
NEXUS_ADMIN_PASSWORD=changeme
NEXUS_MANIFEST_ROOT=/home/ibetanzos/dev/nexus_project/projects
DOCKER_HOST=unix:///var/run/docker.sock
# Production (deployment/docker-compose.yml): backend uses network_mode: host,
# so DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/nexus
# GitHub OAuth App (Phase B1) — base64-encoded 32-byte key, or any passphrase (SHA-256 derived)
NEXUS_SECRETS_KEY=
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=
NEXUS_GITHUB_REDIRECT_URI=https://your-nexus-host/api/github/oauth/callback
# Shared secret for GitHub push webhooks (HMAC SHA-256 via X-Hub-Signature-256)
NEXUS_GITHUB_WEBHOOK_SECRET=
